# Retail Order Exception Control Tower (capstone 02): settings for every script and both services.
#
# First time:   cp lab.env.example lab.env      (lab.env is git-ignored)
# Every shell:  source lab.env
#
# No secrets here. Authentication comes from `gcloud auth application-default login`.
# Resource names end in "vks", as in session 8, so they are easy to spot in the
# shared course project. Values marked "starting value" are to be confirmed by
# the evaluation and recorded in decision_sheet.md.

# ---------- PROJECT ----------
export TREDENCE_GCLOUD_CONFIG="tredence-fde-1"
export GOOGLE_CLOUD_PROJECT="tredence-fde-1"
export GOOGLE_CLOUD_QUOTA_PROJECT="${GOOGLE_CLOUD_PROJECT}"

# Use Vertex AI with your gcloud login instead of an API key (read by ADK and the Gen AI SDK).
export GOOGLE_GENAI_USE_VERTEXAI="TRUE"

# ---------- LOCATIONS (same as session 8) ----------
# Gemini: "global" routes each call to a region with capacity.
export GOOGLE_CLOUD_LOCATION="global"
# Embedding model region, proven in sessions 7 and 8.
export EMBEDDING_LOCATION="us-central1"
# BigQuery dataset and bucket location.
export BIGQUERY_LOCATION="US"
export GCS_LOCATION="US"

# ---------- DOCUMENT AI (parses the runbook and postmortem PDFs) ----------
# Layout Parser is offered only in "us" or "eu"; "us" matches the US bucket and dataset.
export DOCUMENT_AI_LOCATION="us"
# Created once by ingest_docs (find by name, else create), then reused.
export DOCUMENT_AI_PROCESSOR_NAME="retail-control-tower-layout-parser-vks"
# Where the processor ID is saved after creation (under output/, git-ignored).
export DOCUMENT_AI_PROCESSOR_ID_FILE="output/document_ai_processor_id"
# Pinned, so parser output doesn't change between runs (same version as session 8).
# Check tomorrow that it is still offered: models and parser versions retire.
export DOCUMENT_AI_PROCESSOR_VERSION="pretrained-layout-parser-v1.5-2025-08-25"
# Each chunk carries its section headings (e.g. "Carrier delay > Checks").
export INCLUDE_ANCESTOR_HEADINGS="true"

# ---------- RESOURCE NAMES (new for the capstone) ----------
# Cloud Storage: runbook and postmortem PDFs, uploaded from data/docs/.
export GCS_BUCKET="${GOOGLE_CLOUD_PROJECT}-retail-control-tower-vks"
export GCS_DOCS_PREFIX="docs"

# BigQuery: one dataset for the capstone (underscores, no hyphens).
export BQ_DATASET="retail_control_tower_vks"
# Operational tables, loaded from data/tables/*.csv. Read live, never embedded.
export BQ_ORDERS_TABLE="orders"
export BQ_INVENTORY_TABLE="inventory"
export BQ_CARRIER_EVENTS_TABLE="carrier_events"
export BQ_WAREHOUSE_EVENTS_TABLE="warehouse_events"
export BQ_CHANGE_LOG_TABLE="change_log"
# Document register: metadata for every runbook/postmortem PDF (loaded from data/docs/).
export BQ_DOCUMENT_REGISTER_TABLE="document_register"
# Knowledge: runbook and postmortem chunks with embeddings and metadata.
export BQ_DOC_CHUNKS_TABLE="doc_chunks"
# Hand-offs to an analyst (append-only), as in session 8.
export BQ_ESCALATIONS_TABLE="escalations"

# ---------- MODELS ----------
# gemini-2.5-flash (used in sessions 17-19) retired on Vertex AI on 2026-10-20.
# gemini-3.1-flash-lite is the replacement measured in session 8 (agent routing accuracy 1.0).
export ORCHESTRATOR_MODEL="gemini-3.1-flash-lite"
export SPECIALIST_MODEL="gemini-3.1-flash-lite"
export EMBEDDING_MODEL="gemini-embedding-001"
# Gate 3: start at 768, compare with 3072 on the golden questions.
export EMBEDDING_DIMENSION="768"
# Both agents. Google recommends the default 1.0 for Gemini 3 models; 0 vs 1.0 is measured on the golden set.
export MODEL_TEMPERATURE="0"
# HTTP timeout on every Gemini call.
export MODEL_TIMEOUT_SECONDS="30"
# Vertex AI Ranking API (Gate 5). Pinned: @latest moves without a code change, and the relevance
# threshold below was measured on -005 (what @latest pointed to on 2026-11-23).
export RANKING_MODEL="semantic-ranker-default-005"
# Grades free-text phrases in evals only (evals/run_evals.py --judge); never in the request path.
export EVAL_JUDGE_MODEL="gemini-3.1-flash-lite"

# ---------- RETRIEVAL (Gates 2, 4, 5, 12) ----------
# Gate 2 starting value: compare with 256. Passed to Layout Parser's chunking.
export CHUNK_SIZE="512"
# Candidates from BigQuery, kept after reranking, sent to Gemini.
export TOP_K="20"
export TOP_N="5"
# Below this rerank score nothing counts as evidence, so the agent abstains (starting value).
export MIN_RELEVANCE_SCORE="0.3"

# ---------- FRESHNESS (Gate 1) ----------
# Older than this = stale: shown as stale, never used as current evidence (starting values).
# Demo setting: 300 = one load covers ~4h50m of testing. S7 (2 days old) stays stale; no healthy
# order passes its promise within 5 h. Production would use much shorter limits (~1 h).
export ORDER_MAX_AGE_MINUTES="300"
export INVENTORY_MAX_AGE_MINUTES="300"
# Carrier silence on a shipment in transit before the cause is "unknown" (RB-CAR-003).
export CARRIER_SILENCE_HOURS="48"

# ---------- CACHE (Gate 10; inventory and the final answer are never cached) ----------
# Order: 0 = no cache, because a fresh BigQuery read is quick.
export ORDER_CACHE_TTL_SECONDS="0"
# Runbook retrieval: 1 day, and also cleared when the index version changes.
export RETRIEVAL_CACHE_TTL_SECONDS="86400"
# Query embedding: 30 days, keyed on text + model + dimension.
export QUERY_EMBEDDING_CACHE_TTL_SECONDS="2592000"

# ---------- HARNESS BUDGETS (Gate 11, per invocation; from session 13, enforced in code) ----------
# The longest planned path (S6: order, fulfilment, changes, before/after, runbook, answer) needs
# 5-6 model calls and 5 tools; 8 and 10 leave room for one retry without allowing loops.
export MAX_MODEL_CALLS_PER_INVOCATION="8"
export MAX_TOOL_CALLS_PER_INVOCATION="10"
export MAX_SAME_TOOL_CALLS="3"
export MAX_FAILURES_PER_INVOCATION="2"
# Measured on GCP: a full investigation takes 24-30 s, of which the A2A call is 9-15 s.
export MAX_INVOCATION_SECONDS="90"
# Hard deadline on one analyst request (also stops a call that hangs); the answer is then "partial".
export REQUEST_DEADLINE_SECONDS="105"

# ---------- SERVICES AND A2A (ports as in sessions 17 and 19) ----------
export APP_NAME="retail_control_tower_vks"
# Web app + orchestrator.
export WEB_HOST="127.0.0.1"
export WEB_PORT="8080"
# Fulfilment Specialist: a separate service.
export FULFILMENT_AGENT_HOST="127.0.0.1"
export FULFILMENT_AGENT_PORT="8001"
export FULFILMENT_AGENT_CARD_URL="http://${FULFILMENT_AGENT_HOST}:${FULFILMENT_AGENT_PORT}/.well-known/agent-card.json"
# After this, the fulfilment check is "unavailable" and the answer is partial.
# Measured: 9-15 s per call (5 model calls in the specialist), so 30 s leaves room for a slow minute.
export FULFILMENT_TIMEOUT_SECONDS="30"

# ---------- SESSIONS (Gate 8; as in session 17) ----------
# local_sqlite = database-backed ADK sessions; vertex = managed (production step).
export SESSION_BACKEND="local_sqlite"
# Under output/, which is git-ignored (data/ holds only sample data).
export SESSION_DB_FILE="output/sessions.db"
# Only for SESSION_BACKEND=vertex: the Agent Engine that holds the sessions.
export VERTEX_AGENT_ENGINE_ID=""
export AGENT_ENGINE_LOCATION="us-central1"

# ---------- CONTEXT BUDGET (Gate 9) ----------
# Every 4 turns, older turns are summarized (IDs, numbers and evidence IDs kept word for word);
# the last turn stays as it is.
export COMPACTION_INTERVAL="4"
export COMPACTION_OVERLAP="1"

# ---------- IDENTITY (session 17 pattern; training only, NOT authentication) ----------
export LAB_ENVIRONMENT="training"
export IDENTITY_SALT="replace-with-any-random-string"

# ---------- OUTPUT ----------
# Local logs, escalations and eval results (git-ignored).
export OUTPUT_DIR="output"
