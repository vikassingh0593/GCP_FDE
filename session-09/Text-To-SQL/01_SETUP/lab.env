export GOOGLE_CLOUD_PROJECT="tredence-fde-1"
export GOOGLE_CLOUD_LOCATION="us-central1"
export GOOGLE_GENAI_USE_VERTEXAI="TRUE"

export TEXT2SQL_DATASET="tredence_fde_1_text2sql"
export TEXT2SQL_BUCKET="${GOOGLE_CLOUD_PROJECT}-tredence-fde-1-text2sql"

export TEXT2SQL_MODEL="gemini-2.5-flash"
export TEXT2SQL_EMBEDDING_MODEL="gemini-embedding-001"

export TEXT2SQL_KNOWLEDGE_TOP_K="6"
export TEXT2SQL_METRIC_TOP_K="3"

export TEXT2SQL_LEXICAL_WEIGHT="0.40"
export TEXT2SQL_SEMANTIC_WEIGHT="0.60"

export TEXT2SQL_MAX_BYTES="1000000000"
export TEXT2SQL_MAX_ROWS="100"
export TEXT2SQL_REPAIR_ATTEMPTS="1"