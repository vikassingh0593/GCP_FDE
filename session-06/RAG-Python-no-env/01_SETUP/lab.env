# -----------------------------
# Google Cloud / Vertex AI
# -----------------------------

export GOOGLE_CLOUD_PROJECT="tredence-fde-1"
export GOOGLE_CLOUD_LOCATION="asia-south1"
export GOOGLE_GENAI_USE_VERTEXAI="true"

# -----------------------------
# H2 Compact resources
# -----------------------------

export H2_COMPACT_DATASET="tredence_fde_rag_vks"
export H2_COMPACT_BUCKET="${GOOGLE_CLOUD_PROJECT}-tredence-fde-rag-vks"

# -----------------------------
# Models
# -----------------------------

export H2_AGENT_MODEL="gemini-2.5-flash"
export H2_EMBEDDING_MODEL="gemini-embedding-001"