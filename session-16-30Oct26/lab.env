# Tredence GCP FDE environment
export TREDENCE_GCLOUD_CONFIG="tredence-fde-1"
export GOOGLE_CLOUD_PROJECT="tredence-fde-1"
export GOOGLE_CLOUD_LOCATION="global"
export GOOGLE_CLOUD_QUOTA_PROJECT="${GOOGLE_CLOUD_PROJECT}"
export GOOGLE_GENAI_USE_VERTEXAI="TRUE"
export MODEL_ID="gemini-2.5-flash"

# Trusted request metadata for the lab.
export LAB_TENANT_ID="tenant-retail-a"
export LAB_USER_ID="fde-user-101"
export LAB_ENVIRONMENT="training"

# Enterprise harness policy.
export MAX_MODEL_CALLS_PER_INVOCATION="6"
export MAX_TOOL_CALLS_PER_INVOCATION="8"
export MAX_SAME_TOOL_CALLS="3"
export MAX_FAILURES_PER_INVOCATION="2"
export MAX_INVOCATION_SECONDS="45"

# Deterministic failure injection.
export SIMULATE_TELEMETRY_FAILURE="false"

# ============================================================
# Topic 19 — ADK Sessions, State & Memory
# ============================================================
export APP_NAME="tredence_stateful_customer_success"
export LAB_HOST="127.0.0.1"
export LAB_PORT="8080"

# local_sqlite = persistent ADK DatabaseSessionService
# in_memory    = non-persistent comparison mode
# vertex       = managed VertexAiSessionService extension
export SESSION_BACKEND="local_sqlite"

# Keep this as a filename, not a fragile relative SQLAlchemy URL.
# The application resolves it against the project root and creates data/.
export SESSION_DB_FILE="data/adk_sessions.db"

# in_memory   = cross-session memory within one server process
# memory_bank = managed persistent Vertex AI Memory Bank extension
export MEMORY_BACKEND="in_memory"

# Optional managed GCP extension. Leave blank for the core two-hour lab.
export AGENT_PLATFORM_PROJECT="${GOOGLE_CLOUD_PROJECT}"
export AGENT_PLATFORM_LOCATION="us-central1"
export AGENT_ENGINE_ID=""
export AGENT_ENGINE_RESOURCE_NAME=""

export MEMORY_BANK_PROJECT="${GOOGLE_CLOUD_PROJECT}"
export MEMORY_BANK_LOCATION="us-central1"
export MEMORY_BANK_AGENT_ENGINE_ID=""

# Training identification only — NOT authentication.
export IDENTITY_SALT="tredence-topic19-training"
